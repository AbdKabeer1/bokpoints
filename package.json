{
  "name": "bokpoints",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm --filter @bokpoints/shared build && pnpm --filter @bokpoints/api build && pnpm --filter @bokpoints/web build",
    "typecheck": "pnpm --filter @bokpoints/shared build && pnpm -r --parallel --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "pnpm --filter @bokpoints/api db:generate",
    "db:migrate": "pnpm --filter @bokpoints/api db:migrate",
    "demo": "pnpm --filter @bokpoints/api demo",
    "bootstrap:admin": "pnpm --filter @bokpoints/api bootstrap:admin",
    "staff:login": "pnpm --filter @bokpoints/api staff:login"
  },
  "devDependencies": {
    "@bokpoints/config": "workspace:*",
    "@types/node": "25.9.9",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
