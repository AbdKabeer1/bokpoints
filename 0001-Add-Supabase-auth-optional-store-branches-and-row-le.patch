+      SET name = EXCLUDED.name,
+          is_admin = EXCLUDED.is_admin,
+          auth_user_id = EXCLUDED.auth_user_id
+    RETURNING id
+  `);
+
+  const id = result.rows[0]?.id;
+  if (!id) throw new Error('Could not create the staff account');
+  return id;
+}
