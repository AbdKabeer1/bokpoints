{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @bokpoints/shared build && pnpm --filter @bokpoints/api build"
  },
  "deploy": {
    "startCommand": "HOST=0.0.0.0 node apps/api/dist/server.js",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
