# Names only. Never commit real values.
#
# Local development uses:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/bokpoints_dev
#
DATABASE_URL=
PORT=
HOST=
LOG_LEVEL=
NODE_ENV=
RATE_LIMIT_MAX=
# 1 behind Railway/Render/Vercel, empty locally.
TRUST_PROXY=
ALLOW_DEV_AUTH=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
# Mailtrap Email Sending (live) and Sandbox (local/test) use different tokens.
MAILTRAP_API_TOKEN=
MAILTRAP_SANDBOX_TOKEN=
MAILTRAP_INBOX_ID=
EMAIL_FROM=no-reply@example.fi
