# The Supabase project URL and its publishable key. The publishable key is
# public by design; it is the same value the browser sends to Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only for a deployed build. Empty means "same origin", which is what the
# Vite dev proxy provides.
VITE_API_BASE=
