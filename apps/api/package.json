{
  "name": "@bokpoints/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "bootstrap:admin": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "staff:login": "tsx --env-file-if-exists=.env scripts/staff-login.ts",
    "customer:code": "tsx --env-file-if-exists=.env scripts/customer-code.ts",
    "expiry:run": "tsx --env-file-if-exists=.env scripts/expiry-run.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@bokpoints/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-zod": "1.0.1",
    "@sentry/node": "^11.9.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.13",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
